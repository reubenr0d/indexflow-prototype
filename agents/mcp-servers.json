{
  "vault-manager-mcp": {
    "command": "node",
    "args": ["apps/mcps/vault-manager/index.js"],
    "envPassthrough": [
      "DEPLOYMENT_CONFIG",
      "RPC_URL",
      "PRIVATE_KEY",
      "SEPOLIA_RPC_URL",
      "FUJI_RPC_URL",
      "ARBITRUM_SEPOLIA_RPC_URL",
      "MANTLE_SEPOLIA_RPC_URL",
      "AGENT_NAME",
      "AGENT_CHURN_GUARD_DISABLED",
      "AGENT_CHURN_GUARD_WINDOW_MS"
    ]
  },
  "yfinance-mcp": {
    "command": "node",
    "args": ["apps/mcps/yfinance/index.js"],
    "envPassthrough": [
      "AGENT_NAME",
      "AGENT_NEWS_CACHE_TTL_MS",
      "AGENT_NEWS_CACHE_DISABLED"
    ]
  },
  "atlas-ml-mcp": {
    "command": "node",
    "args": ["apps/mcps/atlas-ml/index.js"],
    "envPassthrough": [
      "ATLAS_API_URL",
      "ATLAS_API_KEY",
      "ATLAS_AUTH_MODE",
      "ATLAS_BASIC_AUTH",
      "ATLAS_USERNAME",
      "ATLAS_PASSWORD",
      "ATLAS_AUTH_HEADER_NAME",
      "ATLAS_AUTH_HEADER_VALUE",
      "ATLAS_REQUEST_TIMEOUT_MS"
    ]
  },
  "atlas-quality-mcp": {
    "command": "node",
    "args": ["apps/mcps/atlas-quality/index.js"],
    "envPassthrough": [
      "ATLAS_API_URL",
      "ATLAS_API_KEY",
      "ATLAS_REQUEST_TIMEOUT_MS"
