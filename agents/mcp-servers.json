    "args": ["apps/mcps/vault-manager/index.js"],
    "envPassthrough": [
      "DEPLOYMENT_CONFIG",
      "RPC_URL",
      "PRIVATE_KEY"
    ]
  },
  "yfinance-mcp": {
    "command": "node",
    "args": ["apps/mcps/yfinance/index.js"],
