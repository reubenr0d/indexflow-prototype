  "bybit-mcp": {
    "command": "node",
    "args": ["apps/mcps/bybit/index.js"],
    "envPassthrough": [
      "BYBIT_API_KEY",
      "BYBIT_API_SECRET",
      "BYBIT_TESTNET",
      "AGENT_NAME"
    ]
  },
  "nansen-mcp": {
    "command": "node",
    "args": ["apps/mcps/nansen/index.js"],
    "envPassthrough": [
      "NANSEN_API_KEY",
      "NANSEN_BASE_URL",
      "ENVIO_URL",
      "PROJECT_ROOT",
      "AGENT_NAME"
    ]
  }
