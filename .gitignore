# Compiler files
cache/
out/
lcov.info

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Dotenv files (templates stay tracked: `.env.example`, `**/.env.example`)
.env
.env.local
apps/web/.env.local

node_modules/

apps/web/test-results/
apps/web/playwright-report/
.vercel

# Agent memory and metadata are tracked in git. CI (vault-agent[bot]) commits
# updates to agents/memory/ and apps/web/public/agent-metadata/ after each
# scheduled run — see docs/AGENTS_FRAMEWORK.md for details.

.DS_Store

# Self-improver meta-loop scratch dir (proposal manifest + risk-officer
# verdict + signal snapshot + recent verdicts). Regenerated every CI tick
# by .github/workflows/vault-agent.yml `self-improve` job and uploaded as
# the `self-improver-artefacts` artefact for audit; never committed.
.agent-self-improvement/
