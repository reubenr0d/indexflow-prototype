# Required for local HyperSync usage outside Envio Cloud
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# RPC endpoints used by event handlers for `eth_call` reads (basket state,
# vault accounting, routing weights, etc.). Public RPCs that accept anonymous
# eth_call are fine — Envio's hypersync URLs (`https://*.rpc.hypersync.xyz`)
# require ENVIO_API_TOKEN above. If unset, sane public defaults are used
# (see apps/envio/src/utils/contractCalls.ts).
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
FUJI_RPC_URL="https://avalanche-fuji-c-chain-rpc.publicnode.com"
ARBITRUM_SEPOLIA_RPC_URL="https://arbitrum-sepolia-rpc.publicnode.com"
MANTLE_SEPOLIA_RPC_URL="https://rpc.sepolia.mantle.xyz"
# HUB_RPC_URL / SPOKE_RPC_URL override the dual-Anvil local URLs (chain ids
# 31337 / 31338). Defaults to http://127.0.0.1:8545 and http://127.0.0.1:8546.
# HUB_RPC_URL="http://127.0.0.1:8545"
# SPOKE_RPC_URL="http://127.0.0.1:8546"

# Optional if/when contracts are deployed to Arbitrum Sepolia
ARBITRUM_SEPOLIA_BASKET_FACTORY_ADDRESS="0x0000000000000000000000000000000000000000"
ARBITRUM_SEPOLIA_VAULT_ACCOUNTING_ADDRESS="0x0000000000000000000000000000000000000000"
ARBITRUM_SEPOLIA_ORACLE_ADAPTER_ADDRESS="0x0000000000000000000000000000000000000000"
ARBITRUM_SEPOLIA_STATE_RELAY_ADDRESS="0x0000000000000000000000000000000000000000"
